---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "A 506-site directory: the first consumer suite of the web-estate." } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#9671;</text></svg>" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="brand">&#9671; estate directory</a>
        <span class="muted">a web-estate consumer suite</span>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p class="muted">
        Dataset scraped from <a href="https://tabworthy.pages.dev/">tabworthy.pages.dev</a>
        (506 sites, 2026-11-01). Built with Astro + Solid islands; search by @est/search.
      </p>
    </footer>
    <style is:global>
      :root {
        --bg: #faf9f5;
        --fg: #1c1c1a;
        --muted: #6f6d66;
        --card: #ffffff;
        --accent: #3b6ef5;
        --border: #e4e1d6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17181a;
          --fg: #e8e6df;
          --muted: #97958c;
          --card: #1f2124;
          --border: #2e3134;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.55;
      }
      main { max-width: 64rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
      header { border-bottom: 1px solid var(--border); }
      nav {
        max-width: 64rem; margin: 0 auto; padding: 0.9rem 1.25rem;
        display: flex; gap: 1rem; align-items: baseline;
      }
      .brand { font-weight: 700; text-decoration: none; color: var(--fg); }
      a { color: var(--accent); }
      .muted { color: var(--muted); font-size: 0.85rem; }
      footer { border-top: 1px solid var(--border); padding: 1rem 1.25rem 2rem; }
      footer p { max-width: 64rem; margin: 0 auto; }
      h1 { font-size: 1.7rem; margin: 0.4rem 0 0.8rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 0.8rem; }
      .card {
        background: var(--card); border: 1px solid var(--border); border-radius: 10px;
        padding: 0.85rem 1rem;
      }
      .card h3 { margin: 0 0 0.25rem; font-size: 1rem; }
      .card p { margin: 0.2rem 0; font-size: 0.86rem; color: var(--muted); }
      .chip {
        display: inline-block; margin: 0.15rem 0.25rem 0.15rem 0; padding: 0.05rem 0.5rem;
        border: 1px solid var(--border); border-radius: 999px; font-size: 0.75rem; color: var(--muted);
      }
      .stats { display: flex; gap: 1.4rem; margin: 0.6rem 0 1.4rem; flex-wrap: wrap; }
      .stats b { font-size: 1.15rem; }
    </style>
  </body>
</html>
